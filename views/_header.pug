header.header
    nav.na.nav--tours 
        a.nav__el(href='/') All tours
    .header__logo 
        img(src='/img/logo-white.png' alt='Natours logo')
    nav.nav.nav--user 
        if(user)
            a.nav__el(href='#') Log out
            a.nav__el(href='#')
                img.nav__user-img(src=`/img/users/${user.photo}`,alt= `${username}`)
                span= user.name.split(" ")[0]
        else 
            button.nav__el(id='login') Log in 
            button.nav__el.nav__el--cta(id='sign-up') Sign up

